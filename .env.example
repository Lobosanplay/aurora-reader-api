AI_PROVIDER=unconfigured
# Choose AI_PROVIDER=openai or AI_PROVIDER=gemini; set only its key privately on the backend.
# OPENAI_API_KEY=replace-in-private-environment
# GEMINI_API_KEY=replace-in-private-environment
OPENAI_TEXT_MODEL=gpt-6.1-terra
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
AI_REQUEST_TIMEOUT_SECONDS=30
MAX_RESPONSE_TOKENS=600
ALLOWED_ORIGINS=["http://localhost:5173"]
DEPLOYMENT_MODE=local
TRUSTED_GATEWAY_ENABLED=false
REQUESTS_PER_WINDOW=60
RATE_WINDOW_SECONDS=60
SUPPORTED_LANGUAGES=[]
MAX_ANSWER_CHARS=2000
MAX_TRANSCRIPT_CHARS=4000
# Production only: configure API_ACCESS_KEY through a protected secret store, not this file.
